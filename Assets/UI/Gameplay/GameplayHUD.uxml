<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="hud-container" style="flex-grow: 1;">
        <ui:VisualElement name="filtro-escuro" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.59); display: none;" />
        <ui:VisualElement name="player-panel" style="flex-grow: 1; position: absolute; top: 20px; left: 20px; width: 630px; height: 222px; background-image: url(&quot;project://database/Assets/Sprites/Craftpix_UI/character_panel.png?fileID=-1883652620&amp;guid=23b1ad7b3186609469c5451496c18582&amp;type=3#hud_player_frame&quot;); -unity-background-scale-mode: scale-to-fit;">
            <ui:VisualElement name="hp-bar-background" style="flex-grow: 1; width: 342px; height: 13px; left: 218px; top: 63px; transform-origin: left;">
                <ui:VisualElement name="hp-bar" style="flex-grow: 1; position: absolute; top: auto; left: auto; width: 100%; height: 13px; background-image: url(&quot;project://database/Assets/Sprites/Craftpix_UI/character_panel.png?fileID=381326054&amp;guid=23b1ad7b3186609469c5451496c18582&amp;type=3#bar_fill_hp&quot;); transform-origin: left; justify-content: space-between;" />
            </ui:VisualElement>
            <ui:VisualElement name="mp-bar" style="flex-grow: 1; position: absolute; top: 97px; left: 225px; width: 287px; height: 14px; background-image: url(&quot;project://database/Assets/Sprites/Craftpix_UI/character_panel.png?fileID=2093161683&amp;guid=23b1ad7b3186609469c5451496c18582&amp;type=3#bar_fill_mp&quot;); transform-origin: left;" />
            <ui:VisualElement name="avatar" style="flex-grow: 1; position: absolute; height: 153px; width: 150.5px; top: 35px; left: 48px; background-image: url(&quot;project://database/Assets/Sprites/Craftpix_UI/character_panel.png?fileID=793808506&amp;guid=23b1ad7b3186609469c5451496c18582&amp;type=3#hud_avatar&quot;);" />
            <ui:VisualElement name="green-bar" style="flex-grow: 1; position: absolute; top: 132px; left: 217px; width: 256px; height: 14px; background-image: url(&quot;project://database/Assets/Sprites/Craftpix_UI/character_panel.png?fileID=841983997&amp;guid=23b1ad7b3186609469c5451496c18582&amp;type=3#bar_green&quot;); transform-origin: left;" />
        </ui:VisualElement>
        <ui:VisualElement name="boss-panel" style="flex-grow: 1; position: absolute; top: 80%; left: 50%; width: 900px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; right: auto; height: 100px; -unity-background-image-tint-color: rgb(111, 111, 111); transform-origin: center; translate: -50% 0; display: none;">
            <ui:Label tabindex="-1" text="Esqueleto" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lblBoss" style="font-size: 34px; -unity-font: url(&quot;project://database/Assets/UI/Fonts/Daydream.otf?fileID=12800000&amp;guid=f1802d56206c8954ca1b2c3000f20737&amp;type=3#Daydream&quot;); -unity-font-definition: initial; -unity-text-align: upper-center; align-items: stretch; align-self: auto; color: rgb(0, 0, 0);" />
