            <ui:Button name="btn-menu" text="MENU" style="width: 360px; height: 64px; font-size: 26px; color: rgb(224, 224, 224); background-color: rgba(15, 20, 35, 0.95); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(255, 183, 3); border-right-color: rgb(255, 183, 3); border-top-color: rgb(255, 183, 3); border-bottom-color: rgb(255, 183, 3); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;" />
