<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=64edfd253fd43d941a9185863b6992f3&amp;type=3#MainMenuStyles" />
    <ui:VisualElement name="cutscene-root" style="flex-grow: 1; background-color: rgb(10, 12, 22); justify-content: flex-end; align-items: center;">
        <ui:VisualElement name="painel-dialogo" style="position: absolute; left: 8%; right: 8%; bottom: 7%; min-height: 160px; flex-direction: row; align-items: center; background-color: rgba(15, 20, 35, 0.92); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(255, 183, 3); border-right-color: rgb(255, 183, 3); border-top-color: rgb(255, 183, 3); border-bottom-color: rgb(255, 183, 3); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; padding-left: 28px; padding-right: 28px; padding-top: 20px; padding-bottom: 20px;">
            <ui:VisualElement name="retrato" style="width: 120px; height: 120px; margin-right: 24px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; display: none;" />
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Label name="lbl-falante" text="MESTRE" style="font-size: 26px; color: rgb(255, 183, 3); -unity-font-style: bold; margin-bottom: 10px;" />
                <ui:Label name="lbl-texto" text="..." style="font-size: 24px; color: rgb(235, 235, 235); white-space: normal;" />
                <ui:Label name="lbl-dica" text="clique ou aperte ESPAÇO para continuar" style="font-size: 14px; color: rgba(255, 255, 255, 0.45); -unity-text-align: middle-right; margin-top: 8px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="painel-escolha" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(6, 8, 16, 0.72); display: none; justify-content: center; align-items: center;">
            <ui:Label text="ESCOLHA SEU CAMINHO" style="font-size: 44px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 36px;" />
            <ui:VisualElement name="linha-cards" style="flex-direction: row; justify-content: center; align-items: stretch;">
                <ui:VisualElement name="card-mago" style="width: 340px; margin-left: 18px; margin-right: 18px; background-color: rgba(20, 26, 48, 0.95); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(90, 140, 255); border-right-color: rgb(90, 140, 255); border-top-color: rgb(90, 140, 255); border-bottom-color: rgb(90, 140, 255); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; padding-left: 22px; padding-right: 22px; padding-top: 22px; padding-bottom: 22px; align-items: center;">
                    <ui:Label text="MAGO" style="font-size: 34px; color: rgb(120, 170, 255); -unity-font-style: bold; margin-bottom: 4px;" />
                    <ui:Label text="Controle e explosão" style="font-size: 18px; color: rgba(255, 255, 255, 0.7); margin-bottom: 16px;" />
                    <ui:Label text="Domina energia arcana. Dano em área e controle de grupo. Joga de longe, mais frágil de perto." style="font-size: 16px; color: rgb(225, 225, 225); white-space: normal; -unity-text-align: middle-center; margin-bottom: 18px;" />
                    <ui:Button name="btn-mago" text="ESCOLHER MAGO" style="width: 100%; height: 56px; font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); background-color: rgb(45, 90, 190); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(150, 195, 255); border-right-color: rgb(150, 195, 255); border-top-color: rgb(150, 195, 255); border-bottom-color: rgb(150, 195, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;" />
                </ui:VisualElement>
                <ui:VisualElement name="card-paladino" style="width: 340px; margin-left: 18px; margin-right: 18px; background-color: rgba(40, 24, 22, 0.95); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(255, 150, 90); border-right-color: rgb(255, 150, 90); border-top-color: rgb(255, 150, 90); border-bottom-color: rgb(255, 150, 90); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; padding-left: 22px; padding-right: 22px; padding-top: 22px; padding-bottom: 22px; align-items: center;">
                    <ui:Label text="PALADINO" style="font-size: 34px; color: rgb(255, 170, 110); -unity-font-style: bold; margin-bottom: 4px;" />
                    <ui:Label text="Vida e crítico" style="font-size: 18px; color: rgba(255, 255, 255, 0.7); margin-bottom: 16px;" />
                    <ui:Label text="Entra, suporta dano e devolve. Dano alto em alvo único, dash e evasão. Precisa de timing." style="font-size: 16px; color: rgb(225, 225, 225); white-space: normal; -unity-text-align: middle-center; margin-bottom: 18px;" />
                    <ui:Button name="btn-paladino" text="ESCOLHER PALADINO" style="width: 100%; height: 56px; font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); background-color: rgb(190, 90, 45); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(255, 175, 120); border-right-color: rgb(255, 175, 120); border-top-color: rgb(255, 175, 120); border-bottom-color: rgb(255, 175, 120); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="fade-tela" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); opacity: 0; transition-duration: 1s; transition-property: opacity;" />
    </ui:VisualElement>
</ui:UXML>
